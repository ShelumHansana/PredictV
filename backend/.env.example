# Database
DATABASE_URL=sqlite+aiosqlite:///./predictv.db
# For PostgreSQL (Docker): DATABASE_URL=postgresql+asyncpg://predictv:predictv@localhost:5432/predictv

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Application
APP_NAME=PredictV
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML Models
MODEL_DIR=./ml_models
SYNTHETIC_DATA_DIR=./data

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@predictv.com

# Reports
REPORT_DIR=./reports
